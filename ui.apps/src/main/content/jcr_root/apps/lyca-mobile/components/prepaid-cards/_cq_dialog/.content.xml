<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">

                <items jcr:primaryType="nt:unstructured">

                    <!-- ================= GENERAL TAB ================= -->
                    <general
                        jcr:primaryType="nt:unstructured"
                        jcr:title="General"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section Heading"
                                name="./heading"
                                value="Prepaid SIM-only phone plans"/>

                            <description
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="Section Description"
                                name="./description"
                                value="Choose from our best national &amp; international prepaid phone plans, available without any contracts or commitments."/>

                            <bestValueLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Best Value Tab Label"
                                name="./bestValueLabel"
                                value="Best Value"/>

                            <longTermLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Long Term Tab Label"
                                name="./longTermLabel"
                                value="Long term plans"/>

                        </items>
                    </general>

                    <!-- ================= PLANS TAB ================= -->
                    <plans
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Plans"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <plansList
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Plan Cards"
                                composite="true">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./plans">

                                    <items jcr:primaryType="nt:unstructured">

                                        <planTag
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Plan Tag (e.g. Unlimited Plus)"
                                            name="./planTag"/>

                                        <title
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Plan Title"
                                            name="./title"
                                            value="Unlimited"/>
                                        
                                        <authoringLabel
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Authoring Data Label"
                                            name="./authoringLabel"
                                            emptyText="Data"/>

                                        <price
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Price"
                                            name="./price"
                                            value="$49.00"/>

                                        <duration
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Duration"
                                            name="./duration"
                                            value="/30 days"/>

                                        <features
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                            fieldLabel="Plan Features"
                                            composite="{Boolean}true">

                                            <field
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                name="./features">

                                                <items jcr:primaryType="nt:unstructured">
                                                    <feature
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                        fieldLabel="Feature Text"
                                                        name="./text"
                                                        emptyText="e.g. Unlimited calls and texts"/>
                                                </items>

                                            </field>
                                        </features>

                                        <buyCta
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Buy Button Label"
                                            name="./buyCta"
                                            value="Buy now"/>

                                        <basketCta
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Add to Basket Label"
                                            name="./basketCta"
                                            value="Add to basket"/>

                                        <esimNote
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="eSIM Note"
                                            name="./esimNote"
                                            value="Get Immediate Activation with eSIM"/>

                                    </items>
                                </field>
                            </plansList>

                        </items>
                    </plans>

                    <!-- ================= EXISTING CUSTOMER TAB ================= -->
                    <existingCustomer
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Existing Customer Card"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <existingTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Card Title"
                                name="./existingTitle"
                                value="Are you an existing customer?"/>

                            <existingOptions
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Customer Options for Mobile App"
                                fieldDescription="This content will be displayed to users accessing via the mobile app."
                                composite="{Boolean}true">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./existingOptions">

                                    <items jcr:primaryType="nt:unstructured">
                                        <option
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Option Text"
                                            name="./text"
                                            emptyText="e.g. Manage your plan in the app"/>
                                    </items>

                                </field>
                            </existingOptions>


                        </items>
                    </existingCustomer>

                </items>
            </tabs>
        </items>
    </content>
</jcr:root>